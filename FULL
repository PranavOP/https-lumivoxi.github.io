
:root{
--bg:#07111f;--card:rgba(255,255,255,.08);--text:#eef3ff;
--accent:#66d9ff;--accent2:#8b5cf6;
}
*{margin:0;padding:0;box-sizing:border-box;font-family:Inter,Arial,sans-serif}
html{scroll-behavior:smooth}
body{background:linear-gradient(#07111f,#0f1f36);color:var(--text)}
nav{display:flex;justify-content:space-between;align-items:center;padding:24px 8%}
nav ul{display:flex;gap:24px;list-style:none}
nav a{text-decoration:none;color:white}
.logo{font-size:30px;font-weight:700}
.hero{position:relative;overflow:hidden;min-height:100vh}
.hero-inner{max-width:900px;margin:12vh auto;text-align:center;padding:0 20px}
.hero h1{font-size:4rem}
.hero p{font-size:1.2rem;margin:20px 0 30px;color:#c9d8ff}
.btn{background:linear-gradient(90deg,var(--accent),var(--accent2));padding:14px 28px;border-radius:999px;color:white;text-decoration:none}
.glow{position:absolute;border-radius:50%;filter:blur(70px);opacity:.5;animation:float 8s ease-in-out infinite}
.a{width:260px;height:260px;background:#00bfff;top:10%;left:5%}
.b{width:320px;height:320px;background:#8b5cf6;right:5%;bottom:5%}
@keyframes float{50%{transform:translateY(-40px) translateX(20px)}}
.section{padding:90px 8%;text-align:center}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:24px}
.card{background:var(--card);backdrop-filter:blur(12px);padding:28px;border-radius:20px;transition:.3s}
.card:hover{transform:translateY(-10px)}
.stats{display:flex;justify-content:center;gap:60px;padding:70px 20px;flex-wrap:wrap}
.stats div{text-align:center}
.num{font-size:3rem;font-weight:bold;color:var(--accent)}
footer{text-align:center;padding:60px 20px;background:#050b15}
@media(max-width:700px){
nav{flex-direction:column;gap:15px}
.hero h1{font-size:2.5rem}
}


